{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todomoteros.dev/pipeline/spec.schema.json",
  "title": "Android agentic pipeline spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "app", "product", "features", "nonGoals", "constraints", "risks", "openDecisions"],
  "properties": {
    "schema": { "const": 1 },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "applicationId", "namespace", "minSdk", "targetSdk", "compileSdk"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "applicationId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "minSdk": { "type": "integer", "minimum": 21, "maximum": 36 },
        "targetSdk": { "type": "integer", "minimum": 21, "maximum": 36 },
        "compileSdk": { "type": "integer", "minimum": 21, "maximum": 36 },
        "kotlin": { "type": "string" },
        "ui": { "type": "string", "enum": ["compose-material3", "compose-material2", "views"] },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dynamicColor": { "type": "boolean" },
            "darkMode": { "type": "string", "enum": ["system", "light", "dark"] }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitch", "audience", "platforms"],
      "properties": {
        "pitch": { "type": "string", "minLength": 10 },
        "audience": { "type": "string", "minLength": 3 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["phone", "tablet", "foldable", "desktop", "tv", "wear", "auto"] }
        },
        "locale": { "type": "array", "items": { "type": "string" } }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "priority", "description", "acceptance", "screens", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]+$" },
          "name": { "type": "string", "minLength": 3 },
          "priority": { "type": "string", "enum": ["must", "should", "could"] },
          "description": { "type": "string", "minLength": 10 },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "given", "when", "then"],
              "properties": {
                "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
                "given": { "type": "string", "minLength": 3 },
                "when": { "type": "string", "minLength": 3 },
                "then": { "type": "string", "minLength": 3 }
              }
            }
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "states"],
              "properties": {
                "id": { "type": "string", "pattern": "^S[0-9]+$" },
                "name": { "type": "string" },
                "states": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["loading", "empty", "error", "content", "permission", "offline"] }
                }
              }
            }
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entity", "fields"],
              "properties": {
                "entity": { "type": "string" },
                "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "source": { "type": "string", "enum": ["local", "remote", "both"] },
                "persistence": { "type": "string", "enum": ["room", "datastore", "memory", "none"] }
              }
            }
          }
        }
      }
    },
    "nonGoals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "offlineFirst": { "type": "boolean" },
        "auth": { "type": "string" },
        "analytics": { "type": "string" },
        "monetization": { "type": "string" },
        "perfBudgetMs": { "type": "integer", "minimum": 16 },
        "accessibility": { "type": "string" }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "risk", "impact", "mitigation"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "risk": { "type": "string", "minLength": 5 },
          "impact": { "type": "string", "enum": ["high", "med", "low"] },
          "mitigation": { "type": "string", "minLength": 5 }
        }
      }
    },
    "openDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "default"],
        "properties": {
          "id": { "type": "string", "pattern": "^HD-[0-9]+$" },
          "question": { "type": "string" },
          "default": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
